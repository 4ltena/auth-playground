# Copy this file to .env.local and fill in real values for production.
DATABASE_URL="file:./dev.db"

# Signs and verifies JWT access tokens. Use at least 32 random bytes in production
# (e.g. `openssl rand -hex 32`).
JWT_SECRET="dev-only-secret-change-in-production-min-32-bytes"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
