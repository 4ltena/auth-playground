generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  sessions          Session[]
  loginHistory      LoginHistory[]
  securityQuestions SecurityQuestion[]
}

model Session {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  rememberMe Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt, expiresAt])
}

model RefreshToken {
  id String @id @default(cuid())
  sessionId String
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)

  @@index([sessionId])
  @@index([expiresAt])
}

model CaptchaChallenge {
  id String @id
  answerVerifier String
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)

  @@index([expiresAt])
}

// identifier = email alone (NOT email+IP — X-Forwarded-For is spoofable by
// the client, see lib/auth/rateLimit.ts for why). One bucket per email.
model LoginAttempt {
  id            String    @id @default(cuid())
  identifier    String    @unique
  failedCount   Int       @default(0)
  lockedUntil   DateTime? @db.Timestamptz(3)
  lastAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model SecurityQuestion {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionKey String
  answerHash String

  @@unique([userId])
}
